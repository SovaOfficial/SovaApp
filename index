<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SovaApps</title>
<style>
  :root {
    --bg-main: #0a0a0e;
    --bg-panel: #12121a;
    --bg-card: #1a1a24;
    --bg-input: #1e1e28;
    --text-main: #ffffff;
    --text-muted: #8a8a9e;
    --accent-purple: #8b5cf6;
    --accent-purple-hover: #7c3aed;
    --border: #2a2a35;
    --radius: 16px;
    --star-color: #fbbf24;
    --star-empty: #3f3f4e;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  body {
    background-color: var(--bg-main);
    color: var(--text-main);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 20px;
  }

  /* ===== ОСНОВНОЙ КОНТЕЙНЕР ===== */
  .store-container {
    width: 100%;
    max-width: 1000px;
    background: var(--bg-panel);
    border-radius: 24px;
    padding: 24px;
    border: 1px solid var(--border);
  }

  /* ===== ШАПКА ===== */
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .logo-icon {
    font-size: 32px;
    background: var(--accent-purple);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.4);
  }

  .logo-text h1 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .logo-text p {
    font-size: 13px;
    color: var(--text-muted);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-bar {
    display: flex;
    align-items: center;
    background: var(--bg-input);
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    gap: 8px;
    width: 250px;
  }

  .search-bar span {
    color: var(--text-muted);
    font-size: 14px;
  }

  .search-bar input {
    background: transparent;
    border: none;
    color: var(--text-main);
    outline: none;
    width: 100%;
    font-size: 14px;
  }

  .search-bar input::placeholder {
    color: var(--text-muted);
  }

  /* ===== СЕТКА КАРТОЧЕК ===== */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  /* ===== КАРТОЧКА ===== */
  .game-card {
    background: var(--bg-card);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }

  .card-banner {
    height: 180px;
    position: relative;
    display: flex;
    align-items: center;
    padding: 24px;
  }

  .banner-visual {
    background: linear-gradient(135deg, #4c1d95 0%, #1e1b4b 100%);
  }
  .banner-storka {
    background: linear-gradient(135deg, #27272a 0%, #09090b 100%);
  }

  .banner-owl {
    font-size: 80px;
    filter: drop-shadow(0 0 15px rgba(255,255,255,0.2));
    position: absolute;
    right: 20px;
    bottom: -10px;
    z-index: 1;
    opacity: 0.8;
  }

  .banner-content {
    position: relative;
    z-index: 2;
    max-width: 70%;
  }

  .banner-content h2 {
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .banner-content .subtitle {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 12px;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .feature-list li {
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.9);
  }

  .feature-list li::before {
    content: "✔";
    color: var(--accent-purple);
    font-size: 10px;
  }

  /* ===== ИНФО О КАРТОЧКЕ ===== */
  .card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .title-row h3 {
    font-size: 16px;
    font-weight: 700;
  }

  .rating {
    font-size: 13px;
    color: var(--star-color);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .btn-row {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }

  .btn {
    flex: 1;
    padding: 12px 8px;
    border-radius: 10px;
    border: none;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: 0.2s;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-visual-download {
    background: var(--accent-purple);
    color: white;
  }
  .btn-visual-download:hover {
    background: var(--accent-purple-hover);
  }

  .btn-storka-download {
    background: white;
    color: black;
  }
  .btn-storka-download:hover {
    background: #e4e4e7;
  }

  .btn-info {
    background: var(--bg-input);
    color: var(--text-main);
    border: 1px solid var(--border);
  }
  .btn-info:hover {
    background: var(--border);
  }

  /* ===== НИЖНИЙ БАННЕР ===== */
  .bottom-banner {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .bottom-banner span {
    color: var(--accent-purple);
    font-weight: bold;
  }

  /* ===== МОДАЛЬНЫЕ ОКНА ===== */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 100;
  }
  .modal.open { display: flex; }

  .modal-content {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 30px;
    max-width: 400px;
    width: 100%;
    animation: scaleIn 0.2s ease;
  }
  
  .modal-reviews {
    max-height: 85vh;
    overflow-y: auto;
    max-width: 500px;
  }

  @keyframes scaleIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .modal-content h3 {
    margin-bottom: 12px;
    font-size: 20px;
  }
  .modal-content p {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .modal-content .close-btn {
    width: 100%;
    padding: 14px;
    background: var(--accent-purple);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 20px;
  }

  /* ===== ОТЗЫВЫ ВНУТРИ МОДАЛКИ ===== */
  .modal-header-rating {
    font-size: 16px;
    font-weight: bold;
    color: var(--star-color);
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .review-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .stars-input {
    display: flex;
    gap: 8px;
    font-size: 28px;
    cursor: pointer;
  }

  .star {
    color: var(--star-empty);
    transition: color 0.2s, transform 0.1s;
    user-select: none;
  }

  .star.active {
    color: var(--star-color);
  }

  .star:hover {
    transform: scale(1.1);
  }

  .review-textarea {
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    color: var(--text-main);
    font-size: 14px;
    resize: vertical;
    min-height: 80px;
    outline: none;
    font-family: inherit;
  }

  .review-textarea:focus {
    border-color: var(--accent-purple);
  }

  .btn-submit-review {
    align-self: flex-start;
    padding: 12px 24px;
    background: var(--accent-purple);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
  }

  .btn-submit-review:hover {
    background: var(--accent-purple-hover);
  }

  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .review-item {
    background: var(--bg-input);
    border-radius: 12px;
    padding: 16px;
    border: 1px solid var(--border);
  }

  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .review-header strong {
    font-size: 14px;
    color: var(--text-main);
  }

  .review-stars {
    color: var(--star-color);
    font-size: 14px;
  }

  .review-text {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    word-break: break-word;
  }

  @media (max-width: 600px) {
    .header-actions { width: 100%; }
    .search-bar { flex-grow: 1; width: auto; }
    .card-banner { height: 160px; }
    .btn { font-size: 12px; padding: 10px 4px; }
  }
</style>
</head>
<body>

<div class="store-container">
  <!-- ШАПКА -->
  <header>
    <div class="logo-area">
      <div class="logo-icon">🛍️</div>
      <div class="logo-text">
        <h1>SovaApps</h1>
        <p>Выбирай, скачивай и наслаждайся!</p>
      </div>
    </div>
    <div class="header-actions">
      <div class="search-bar">
        <span>🔍</span>
        <input type="text" placeholder="Поиск по SovaApps">
      </div>
    </div>
  </header>

  <!-- КАРТОЧКИ -->
  <div class="cards-grid">
    
    <!-- SovaVisual (Лаунчер Minecraft) -->
    <div class="game-card">
      <div class="card-banner banner-visual">
        <div class="banner-owl">🦉</div>
        <div class="banner-content">
          <h2>SovaVisual</h2>
          <div class="subtitle">Лаунчер для Minecraft</div>
          <ul class="feature-list">
            <li>Быстрый запуск</li>
            <li>Все версии игры</li>
            <li>Оптимизация</li>
          </ul>
        </div>
      </div>
      <div class="card-info">
        <div class="title-row">
          <h3>SovaVisual</h3>
          <div class="rating" id="rating-SovaVisual">⭐ 0.0</div>
        </div>
        <div class="desc">Лучший лаунчер для Minecraft!</div>
        <div class="btn-row">
          <button class="btn btn-visual-download" onclick="downloadApp('SovaVisual')">⬇ Скачать</button>
          <button class="btn btn-info" onclick="openModal('SovaVisual')">ⓘ Инфо</button>
          <button class="btn btn-info" onclick="openReviewModal('SovaVisual')">★ Отзывы</button>
        </div>
      </div>
    </div>

    <!-- SovaStorka (Шторка Windows) -->
    <div class="game-card">
      <div class="card-banner banner-storka">
        <div class="banner-owl" style="filter: grayscale(100%);">🦉</div>
        <div class="banner-content">
          <h2>SovaStorka</h2>
          <div class="subtitle">Шторка уведомлений для Windows</div>
          <ul class="feature-list">
            <li>Стиль смартфона</li>
            <li>Быстрый доступ</li>
            <li>Плавная анимация</li>
          </ul>
        </div>
      </div>
      <div class="card-info">
        <div class="title-row">
          <h3>SovaStorka</h3>
          <div class="rating" id="rating-SovaStorka">⭐ 0.0</div>
        </div>
        <div class="desc">Удобная шторка прямо на ПК!</div>
        <div class="btn-row">
          <button class="btn btn-storka-download" onclick="downloadApp('SovaStorka')">⬇ Скачать</button>
          <button class="btn btn-info" onclick="openModal('SovaStorka')">ⓘ Инфо</button>
          <button class="btn btn-info" onclick="openReviewModal('SovaStorka')">★ Отзывы</button>
        </div>
      </div>
    </div>

  </div>

  <!-- НИЖНИЙ БАННЕР -->
  <div class="bottom-banner">
    <span>ⓘ</span> Выбирай свой вариант и улучшай свой ПК уже сегодня!
  </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО ИНФО -->
<div class="modal" id="infoModal">
  <div class="modal-content">
    <h3 id="modalTitle">Информация</h3>
    <p id="modalText">Текст описания...</p>
    <button class="close-btn" onclick="closeModal('infoModal')">Понятно</button>
  </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО ОТЗЫВОВ -->
<div class="modal" id="reviewModal">
  <div class="modal-content modal-reviews">
    <h3 id="reviewModalTitle">Отзывы</h3>
    <div class="modal-header-rating" id="modalAvgRating">⭐ 0.0 (0 отзывов)</div>
    
    <div class="review-form">
      <div class="stars-input" id="starInput">
        <span class="star" data-value="1">★</span>
        <span class="star" data-value="2">★</span>
        <span class="star" data-value="3">★</span>
        <span class="star" data-value="4">★</span>
        <span class="star" data-value="5">★</span>
      </div>
      <textarea class="review-textarea" id="reviewText" placeholder="Напишите отзыв об этом товаре..."></textarea>
      <button class="btn-submit-review" onclick="submitReview()">Отправить</button>
    </div>
    
    <div class="reviews-list" id="modalReviewsList">
      <!-- Сюда добавляются отзывы для конкретного товара -->
    </div>
    
    <button class="close-btn" onclick="closeModal('reviewModal')">Закрыть</button>
  </div>
</div>

<script>
  // ===== ДАННЫЕ =====
  const appData = {
    'SovaVisual': { 
      title: 'SovaVisual', 
      text: 'SovaVisual — это современный лаунчер для Minecraft. Он обеспечивает быстрый запуск игры, поддерживает все версии и включает в себя встроенную оптимизацию для стабильной работы даже на слабых ПК.' 
    },
    'SovaStorka': { 
      title: 'SovaStorka', 
      text: 'SovaStorka — это шторка уведомлений для Windows в стиле современных смартфонов. Позволяет быстро получать доступ к системным настройкам, уведомлениям и медиа-плееру с помощью свайпа или горячих клавиш. Плавные анимации и стильный дизайн.' 
    }
  };

  // Дефолтные данные
  const defaultStats = {
    'SovaVisual': { totalStars: 0, count: 0, reviews: [] },
    'SovaStorka': { totalStars: 0, count: 0, reviews: [] }
  };

  // Загружаем сохраненные данные из localStorage или берем дефолтные
  let appStats = JSON.parse(localStorage.getItem('sovaAppStats')) || defaultStats;

  // Проверка, чтобы структура не сломалась
  if (!appStats['SovaVisual'] || !appStats['SovaStorka']) {
    appStats = defaultStats;
  }

  let currentApp = '';
  let selectedRating = 0;

  // ===== МОДАЛЬНЫЕ ОКНА =====
  function openModal(appName) {
    document.getElementById('modalTitle').innerText = appData[appName].title;
    document.getElementById('modalText').innerText = appData[appName].text;
    document.getElementById('infoModal').classList.add('open');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('open');
  }

  // Закрытие по клику вне окна
  document.querySelectorAll('.modal').forEach(modal => {
    modal.addEventListener('click', function(e) {
      if (e.target === this) this.classList.remove('open');
    });
  });

  // ===== СКАЧИВАНИЕ =====
  function downloadApp(appName) {
    const content = `Спасибо за скачивание ${appName}!\nДата: ${new Date().toLocaleString('ru-RU')}`;
    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${appName}_install.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // ===== СИСТЕМА ОТЗЫВОВ =====
  function openReviewModal(appName) {
    currentApp = appName;
    selectedRating = 0;
    updateStars(0);
    document.getElementById('reviewText').value = '';
    
    document.getElementById('reviewModalTitle').innerText = 'Отзывы: ' + appName;
    
    updateRatingDisplay(appName);
    renderReviews(appName);
    
    document.getElementById('reviewModal').classList.add('open');
  }

  // Обновление цифры рейтинга на карточке и в модалке
  function updateRatingDisplay(appName) {
    const stats = appStats[appName];
    const avg = stats.count > 0 ? (stats.totalStars / stats.count).toFixed(1) : '0.0';
    
    // Обновляем на карточке товара
    document.getElementById(`rating-${appName}`).innerText = `⭐ ${avg}`;
    
    // Обновляем в модальном окне (только если открыт текущий товар)
    if (currentApp === appName) {
      document.getElementById('modalAvgRating').innerText = `⭐ ${avg} (${stats.count} отзывов)`;
    }
  }

  // Отрисовка списка отзывов
  function renderReviews(appName) {
    const list = document.getElementById('modalReviewsList');
    list.innerHTML = '';
    
    const reviews = appStats[appName].reviews;
    
    if (reviews.length === 0) {
      list.innerHTML = '<p style="color:var(--text-muted); font-size:14px; text-align:center; padding:20px 0;">Пока нет отзывов. Будьте первым!</p>';
      return;
    }

    reviews.forEach(review => {
      let starsHtml = '';
      for (let i = 1; i <= 5; i++) {
        starsHtml += i <= review.rating ? '★' : '☆';
      }

      const reviewDiv = document.createElement('div');
      reviewDiv.className = 'review-item';
      reviewDiv.innerHTML = `
        <div class="review-header">
          <strong>Пользователь</strong>
          <div class="review-stars">${starsHtml}</div>
        </div>
        <div class="review-text">${review.text}</div>
      `;
      list.appendChild(reviewDiv);
    });
  }

  // Обработка звезд
  const stars = document.querySelectorAll('.star');
  
  stars.forEach(star => {
    star.addEventListener('click', () => {
      selectedRating = parseInt(star.getAttribute('data-value'));
      updateStars(selectedRating);
    });

    star.addEventListener('mouseover', () => {
      updateStars(parseInt(star.getAttribute('data-value')));
    });

    star.addEventListener('mouseout', () => {
      updateStars(selectedRating);
    });
  });

  function updateStars(value) {
    stars.forEach(s => {
      if (parseInt(s.getAttribute('data-value')) <= value) {
        s.classList.add('active');
      } else {
        s.classList.remove('active');
      }
    });
  }

  // Отправка отзыва
  function submitReview() {
    const text = document.getElementById('reviewText').value.trim();
    
    if (selectedRating === 0) {
      alert('Пожалуйста, поставьте оценку (звезды).');
      return;
    }
    if (text === '') {
      alert('Пожалуйста, напишите текст отзыва.');
      return;
    }

    // Сохраняем отзыв
    appStats[currentApp].reviews.unshift({
      rating: selectedRating,
      text: text
    });
    
    // Обновляем счетчики для среднего рейтинга
    appStats[currentApp].totalStars += selectedRating;
    appStats[currentApp].count += 1;

    // СОХРАНЯЕМ В LOCALSTORAGE
    localStorage.setItem('sovaAppStats', JSON.stringify(appStats));

    // Обновляем интерфейс
    updateRatingDisplay(currentApp);
    renderReviews(currentApp);

    // Очищаем форму
    document.getElementById('reviewText').value = '';
    selectedRating = 0;
    updateStars(0);
  }

  // Инициализация рейтинга при загрузке страницы
  updateRatingDisplay('SovaVisual');
  updateRatingDisplay('SovaStorka');
</script>

</body>
</html>
